# Applico ATS — environment variables
# Copy to .env (local) or .env.local and fill in real values. Never commit .env.

# ── App / domains ─────────────────────────────────────────────────────────────
# Production root domain (marketing on apex/www, app on app.<domain>,
# career pages on <org-subdomain>.<domain>).
NEXT_PUBLIC_ROOT_DOMAIN=aplico.online
# Local dev root domain. Add to /etc/hosts: 127.0.0.1 aplico.localhost app.aplico.localhost
NEXT_PUBLIC_LOCAL_DOMAIN=aplico.localhost
NEXT_PUBLIC_APP_URL=http://app.aplico.localhost:3000
NEXT_PUBLIC_SITE_URL=http://aplico.localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://aplico.localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://app.aplico.localhost:3000
NEXT_PUBLIC_API_URL=http://app.aplico.localhost:3000/api
FRONTEND_URL=http://app.aplico.localhost:3000
COMPANY_NAME=Applico

# ── Auth (Clerk Organizations) ────────────────────────────────────────────────
# Clerk reads NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY automatically.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Svix signing secret for the Clerk webhook (Clerk Dashboard → Webhooks).
CLERK_WEBHOOK_SECRET=whsec_...

# ── MySQL (Drizzle) ───────────────────────────────────────────────────────────
# The app pool uses the DB_* vars; drizzle-kit (migrations) uses DATABASE_URL.
# Keep both pointing at the same database.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=applico
DATABASE_URL=mysql://root:@127.0.0.1:3306/applico

# ── MongoDB (Mongoose: notes, attachments, email templates, communication log, smart tasks)
MONGODB_URI=mongodb://127.0.0.1:27017/applico

# ── Redis / BullMQ (queues, triggers, socket adapter) ─────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── File storage (Cloudflare R2) ──────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=applico-uploads

# ── Email (Resend + React Email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Applico <hiring@aplico.online>

# ── Google Calendar (per-org OAuth via Clerk oauth_google) ────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://app.aplico.localhost:3000/api/auth/google/callback

# ── Internal trigger secret (SERVER-ONLY) ─────────────────────────────────────
# Shared secret for /api/trigger/public. NEVER expose via NEXT_PUBLIC_* —
# public pages call a server action that adds this secret server-side.
# Rotate immediately if a previous value was ever shipped to the browser.
INTERNAL_TRIGGER_SECRET=

# ── Plugin API key encryption (SERVER-ONLY) ───────────────────────────────────
# AES-256-GCM key for per-org plugin API keys stored in the organization
# `plugins` JSON column (Resend, Google/Gemini, …). 32 bytes, base64 or hex.
# Generate one with:  openssl rand -base64 32
# (or hex: openssl rand -hex 32). NEVER expose via NEXT_PUBLIC_* and never
# commit a real value. Saving a NEW plugin API key fails loudly until this
# is set. The BullMQ worker needs the same value to decrypt keys at use time.
# Rotation: decrypt + re-encrypt stored keys with the new key BEFORE swapping
# this value — rotating first makes every stored key undecryptable (see README).
PLUGIN_ENCRYPTION_KEY=

# ── AI (resume parsing / summaries) ───────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional plugins ──────────────────────────────────────────────────────────
CALENDLY_TOKEN=
CHECKR_API_KEY=
SLACK_WEBHOOK_URL=
TWILIO_FROM=

# ── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
SOCKET_PORT=3001
